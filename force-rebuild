#!/usr/bin/env bash
# Force cargo to recompile every workspace crate.
# Touching sources/manifests invalidates cargo's fingerprints without wiping
# target/, so third-party dependency artifacts stay cached (much faster than
# `cargo clean`). Pass --release etc. through to `cargo build` if needed.
set -euo pipefail

# Re-exec inside the nix dev shell when cargo isn't on PATH (e.g. invoked
# from a bare shell). The guard var prevents an infinite loop if the dev
# shell itself fails to provide cargo.
if ! command -v cargo >/dev/null 2>&1 && [[ -z "${_DEV_SHELL_GUARD:-}" ]]; then
  export _DEV_SHELL_GUARD=1
  exec nix develop --command "$(readlink -f "${BASH_SOURCE[0]}")" "$@"
fi

cd "$(dirname "${BASH_SOURCE[0]}")"
find crates -type f \( -name '*.rs' -o -name 'Cargo.toml' \) -exec touch {} +
touch Cargo.toml
exec cargo build --workspace "$@"
