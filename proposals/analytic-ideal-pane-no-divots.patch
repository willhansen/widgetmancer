-        let mut lefts = Vec::new();
-        let mut rights = Vec::new();
-        for i in 0..NY {
-            let filled_cols: Vec<usize> = (0..NX).filter(|&j| actual.filled(j, i)).collect();
-            if filled_cols.is_empty() {
