-    }
-
-    pub fn wy(&self, i: usize) -> f32 {
-        self.origin.y + (i as f32 + 0.5) / SY as f32
-    }
-
-    pub fn wx(&self, j: usize) -> f32 {
-        self.origin.x + (j as f32 + 0.5) / SX as f32
