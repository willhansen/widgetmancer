-            }
-            lefts.push(actual.wx(*filled_cols.first().unwrap()));
-            rights.push(actual.wx(*filled_cols.last().unwrap()));
-        }
-        m.left_spread = spread(&lefts);
-        m.right_spread = spread(&rights);
