-        let bits = hextant_character_to_binary(c);
-        let col = if fx < 0.5 { 0 } else { 1 };
-        let row = if fy >= 2.0 / 3.0 {
-            0
-        } else if fy >= 1.0 / 3.0 {
-            1
-        } else {
-            2
-        };
