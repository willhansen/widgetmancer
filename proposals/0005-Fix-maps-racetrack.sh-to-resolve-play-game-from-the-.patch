From 11227594ab75d66296a5c3e9fac092a174764411 Mon Sep 17 00:00:00 2001
From: boxed-pi <boxed-pi@localhost>
Date: Wed, 23 Sep 2026 19:55:47 +0000
Subject: [PATCH 5/5] Fix maps/racetrack.sh to resolve play-game from the repo
 root
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The script copied play-game's cd-to-script-dir idiom, but that idiom only
works from the repo root — inside maps/ it looked for maps/play-game and
died with 'No such file or directory'. Drop the cd and reference
../play-game directly (play-game cds itself to the root).
---
 maps/racetrack.sh | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/maps/racetrack.sh b/maps/racetrack.sh
index 36a8049..f637aa4 100755
--- a/maps/racetrack.sh
+++ b/maps/racetrack.sh
@@ -2,5 +2,4 @@
 # Launch the game on the portal cube racetrack map (maps are selected via
 # --map; see crates/game/src/main.rs).
 set -euo pipefail
-cd "$(dirname "${BASH_SOURCE[0]}")"
-exec ./play-game --map racetrack
\ No newline at end of file
+exec "$(dirname "${BASH_SOURCE[0]}")/../play-game" --map racetrack
\ No newline at end of file
-- 
2.49.1

